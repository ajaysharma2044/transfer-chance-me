# Environment template. Copy to .env.local (local dev) or set these in your
# host's dashboard (production). Every variable the code reads is listed here;
# tests/env-example-coverage.test.ts fails if the code grows one that isn't.
#
# With NONE of these set, the app runs entirely on-device: local-device
# accounts, no sync, and the deep review asks the visitor for their own model
# key. Set a group to turn that group on.
#
# Two prefixes, two trust levels:
#   VITE_*  — inlined into the browser bundle at build time. PUBLIC. Never put
#             a secret in one.
#   (no prefix) — server-only, read by Netlify/Vercel functions. Secrets live
#             here. Vite never inlines these, so they stay off the client.


# ════════════════════════════════════════════════════════════════════════════
# CLIENT (VITE_*) — shipped in the browser bundle, so public by design
# ════════════════════════════════════════════════════════════════════════════

# ── Accounts and sync (Supabase) ────────────────────────────────────────────
# Set BOTH to switch from local-device accounts to real ones, with Google
# sign-in and cross-device sync. Supabase dashboard → Settings → API.
# Before first use, run the migrations in supabase/ (schema.sql + migrations/)
# so row-level security is in place before any real record is written.
# The anon key is meant to be public and is safe here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── "Sign in with Google" (legacy browser-only button) ──────────────────────
# Only for the local-accounts mode. With Supabase set, Google is configured IN
# Supabase (Authentication → Providers → Google), not here — leave this empty.
VITE_GOOGLE_CLIENT_ID=

# ── Deep review proxy endpoint ──────────────────────────────────────────────
# Points the browser at the server proxy so visitors never handle a model key.
# REQUIRED IN PRODUCTION: if this is empty in a deployed build, the review flow
# falls back to asking each visitor for their own Anthropic key. Set it to the
# function path, e.g. /api/review (Netlify rewrites this to the function).
VITE_REVIEW_ENDPOINT=/api/review


# ════════════════════════════════════════════════════════════════════════════
# SERVER-ONLY — read by functions. NEVER add a VITE_ prefix to any of these.
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase server access ──────────────────────────────────────────────────
# SUPABASE_URL mirrors the project URL for server code (same value as
# VITE_SUPABASE_URL). SUPABASE_SERVICE_ROLE_KEY bypasses row-level security
# entirely — it is the one key that can read every user's transcripts and
# essays — so it must stay server-side and must never be committed or inlined.
# Used by account deletion and the admin functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Request origin allowlist ────────────────────────────────────────────────
# The site origin the review/account functions accept requests from (CORS and
# an anti-CSRF origin check), e.g. https://your-site.example. Defaults to the
# deploy origin when unset, but set it explicitly in production.
ALLOWED_ORIGIN=

# ── Model backend for the deep review / audit ───────────────────────────────
# OpenRouter takes precedence when set; direct Anthropic is the fallback.
# Get an OpenRouter key at https://openrouter.ai/keys. Rotate any key that has
# ever been pasted into a chat, a screenshot, or a commit.
OPENROUTER_API_KEY=
# Any OpenRouter model id; swap it without a redeploy.
OPENROUTER_MODEL=qwen/qwen3.7-plus
# Direct-Anthropic fallback key (used when OPENROUTER_API_KEY is unset).
ANTHROPIC_API_KEY=
# Attribution URL shown on the OpenRouter dashboard, e.g. https://your-site.example
PUBLIC_SITE_URL=

# ── Rate-limit store (Upstash Redis REST) ───────────────────────────────────
# Backs the per-IP / per-user caps on the paid review endpoint. Optional in
# local dev (the limiter degrades to in-memory); set in production so the cap
# holds across function instances. Upstash console → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ════════════════════════════════════════════════════════════════════════════
# PIPELINE (local data tooling, optional) — not read by the web app
# ════════════════════════════════════════════════════════════════════════════

# Research dataset root, OUTSIDE this repo (and outside the git worktree, so a
# relative ../data does not resolve). The build scripts and the pipeline read
# it; override to point at a copy elsewhere. Default is the owner's local path.
DATA_DIR=/Users/ajaysharma/claude chance me/data
