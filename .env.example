# Copy to .env.local and fill in to activate optional integrations.
# With none of these set the app runs entirely on-device, exactly as before.

# ── Accounts and sync (Supabase) ───────────────────────────────────────────
# Set BOTH to switch from local-device accounts to real ones, with Google
# sign-in and cross-device sync. Get them at:
#   Supabase dashboard → your project → Settings → API
# Before first use, run supabase/schema.sql in the SQL editor — it creates the
# tables and the row-level security that stops one user reading another's file.
#
# The anon key is designed to be public and is safe here. NEVER put the
# service_role key in a VITE_ var: it bypasses row-level security entirely
# and would expose every user's transcripts and essays.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── "Sign in with Google" ──────────────────────────────────────────────────
# With Supabase set above, Google is configured IN SUPABASE instead of here:
#   Authentication → Providers → Google → paste your client ID + secret,
#   then add the callback URL Supabase shows you to the Google console.
# The var below is only for the legacy browser-only button used when Supabase
# is not configured; leave it empty if you are using Supabase.
VITE_GOOGLE_CLIENT_ID=

# ── Deep review proxy (optional) ───────────────────────────────────────────
# Set to /api/review so visitors never handle a model key themselves.
VITE_REVIEW_ENDPOINT=

# ── Model backend for /api/review — SERVER-SIDE ONLY ───────────────────────
# These have NO VITE_ prefix on purpose. Vite inlines every VITE_ var into the
# browser bundle, so prefixing one of these would publish your key to every
# visitor and let anyone spend your credits. Put them in .env.local for
# `vercel dev`, and in the Vercel dashboard for production.
#
# OpenRouter takes precedence when set; Anthropic direct is the fallback.
# Get a key at https://openrouter.ai/keys — and rotate any key that has ever
# been pasted into a chat, a screenshot, or a commit.
OPENROUTER_API_KEY=
# Any OpenRouter model id; swap it without a redeploy.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Attribution shown on the OpenRouter dashboard.
PUBLIC_SITE_URL=

ANTHROPIC_API_KEY=
